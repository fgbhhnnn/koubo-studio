{
  "name": "koubo-studio",
  "private": true,
  "description": "Koubo Studio: talking-head ingest, caption templates and a full editor. Based on the OpenFilm format (MIT) and adu-motion-video packs (MIT).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @koubo/editor dev",
    "dev:studio": "pnpm --filter @koubo/editor dev",
    "koubo": "node packages/koubo/bin/koubo.mjs",
    "test:koubo": "pnpm --filter koubo test",
    "dev:desktop": "pnpm --filter @koubo/desktop start",
    "build": "pnpm --filter @koubo/editor build:ui && pnpm --filter @koubo/desktop build:shell",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit:public": "node scripts/audit-public.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "examples:sync": "node scripts/sync-examples.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1"
  },
  "pnpm": {
    "overrides": {
      "zod@>=4 <4.6.6": "^4.6.6",
      "undici@>=8 <8.12.2": "^8.12.2",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
