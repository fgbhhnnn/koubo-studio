# Copy to .env (ignored by git) or export in your shell. Never commit real keys.
ELEVENLABS_API_KEY=

# Optional: ElevenLabs Scribe model id. Official batch docs: scribe_v2 (scribe_v3 also exists).
# KOUBO_SCRIBE_MODEL=scribe_v2

# Optional LLM slot for logic cleanup. If unset, Koubo uses the rule engine only.
# KOUBO_LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional image generator is a code hook; leaving these empty uses placeholder art.
# KOUBO_IMAGE_API_KEY=
