# Copy to .env (ignored by git) or export in your shell. Never commit real keys.
ELEVENLABS_API_KEY=

# Optional: ElevenLabs Scribe model id. Official batch docs: scribe_v2 (scribe_v3 also exists).
# KOUBO_SCRIBE_MODEL=scribe_v2

# Optional LLM refinement after the rule engine. If unset, Koubo uses the rule engine only.
# KOUBO_LLM_BASE_URL=https://sub.lllltt.com/v1
# KOUBO_LLM_API_KEY=
# KOUBO_LLM_MODEL=gpt6.2sol
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional illustrations via POST {base}/images/generations.
# If KOUBO_IMAGE_API_KEY / BASE_URL are empty, the LLM values are reused.
# Quote the model name when it contains spaces.
# KOUBO_IMAGE_BASE_URL=https://sub.lllltt.com/v1
# KOUBO_IMAGE_API_KEY=
# KOUBO_IMAGE_MODEL="GPT Image 2.6 Sunburst"
